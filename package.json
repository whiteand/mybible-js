{
  "name": "@whiteand/mybible",
  "version": "0.0.5",
  "type": "module",
  "packageManager": "nub@0.7.5",
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "badge:fallow": "nubx fallow health --format badge > .github/badges/health.svg",
    "badge:coverage": "nub run test:coverage && nub scripts/coverage-badge.mjs",
    "badge": "nub run badge:fallow && nub run badge:coverage && git add .github/badges/health.svg && git commit -m 'chore: update badges'",
    "preview": "vite preview",
    "prepublish": "nub run typecheck && nub run test && nub run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "publish": "nub publish --access public",
    "stryker": "stryker run",
    "dry:publish": "nub publish --access public --dry-run"
  },
  "peerDependencies": {
    "better-sqlite3": ">=13.0.0 <14.0.0"
  },
  "devDependencies": {
    "@nubjs/types": ">=0.4.13 <=0.7.5",
    "@stryker-mutator/api": "^10.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "6",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "node-html-parser": "^9.0.4",
    "quartet": "^11.0.4"
  },
  "optionalDependencies": {
    "fallow": "^3.31.0"
  }
}