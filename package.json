{
  "name": "@whiteand/mybible",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "nub@0.7.5",
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.7.5",
      "onFail": "ignore"
    }
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepublish": "nub run typecheck && nub run test && nub run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publish": "nub publish --access public",
    "dry:publish": "nub publish --access public --dry-run"
  },
  "peerDependencies": {
    "better-sqlite3": ">=13.0.0 <14.0.0"
  },
  "devDependencies": {
    "@nubjs/types": ">=0.4.13 <=0.7.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "@typescript/typescript6": "^6.0.2",
    "typescript": "^7",
    "vite": "^8.3.1",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "node-html-parser": "^9.0.4",
    "quartet": "^11.0.4"
  }
}